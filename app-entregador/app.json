{
  "expo": {
    "name": "Route Entregador",
    "slug": "route-entregador",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1628",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.routedelivery.entregador"
    },
    "android": {
      "package": "com.routedelivery.entregador",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#0b1628",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Route Entregador usa sua localização para mostrar corridas perto de você e acompanhar as entregas enquanto você está online.",
          "locationAlwaysAndWhenInUsePermission": "Com “Permitir o tempo todo”, a loja e a equipe acompanham suas entregas mesmo com o app minimizado ou a tela bloqueada, enquanto você está online.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Route Entregador usa a câmera para você tirar a selfie e fotografar a CNH, o comprovante de endereço e o documento do veículo no cadastro.",
          "photosPermission": "O Route Entregador acessa suas fotos para você escolher as imagens dos documentos do cadastro.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notificacao-icone.png",
          "color": "#2a78d6",
          "defaultChannel": "avisos",
          "sounds": ["./assets/corrida.wav"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d1c0f24d-df94-46d7-9e37-f790a2bd753e"
      }
    },
    "owner": "routedelivery",
    "updates": {
      "url": "https://u.expo.dev/d1c0f24d-df94-46d7-9e37-f790a2bd753e"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
