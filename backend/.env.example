# Copie este arquivo para ".env" e preencha com seus valores reais.

# String de conexão com o PostgreSQL
# Exemplo local: postgresql://usuario:senha@localhost:5432/route_delivery
DATABASE_URL="postgresql://usuario:senha@localhost:5432/route_delivery"

# Porta em que a API vai rodar
PORT=4000

# Segredo usado para assinar os tokens JWT (troque por um valor aleatório forte)
JWT_SECRET="troque-por-um-segredo-bem-grande-e-aleatorio"

# Origem(ns) permitida(s) para CORS, separadas por vírgula
# (painel ADM, sistema do comerciante...). O app mobile não precisa de CORS.
CORS_ORIGIN="http://localhost:5173"

# Chave que criptografa as credenciais das integrações (64 caracteres hex).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guarde com cuidado: sem ela as credenciais salvas não podem ser lidas.
INTEGRACOES_CHAVE=""

# Endereço público da API (usado para montar a URL do webhook de entrada das integrações).
# Ex.: https://api.suaempresa.com.br — em branco, usa o endereço da requisição.
API_URL_PUBLICA=""

# Senha do usuário administrador criado pelo seed inicial
SEED_ADMIN_EMAIL="admin@routedelivery.com"
SEED_ADMIN_SENHA="troque-esta-senha"

# Primeiro administrador (só é criado se o banco ainda não tiver nenhuma conta gerencial).
# Usado ao publicar num banco novo; depois do primeiro acesso pode ser apagado.
ADMIN_EMAIL=""
ADMIN_SENHA=""
ADMIN_NOME="Administrador"
